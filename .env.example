# Copy this to .env and fill in your secrets and settings.
# Do NOT commit .env with real keys.

# Ollama model to use (example: qwen2.5:0.5b)
OLLAMA_MODEL=qwen2.5:0.5b
# Ollama local server URL (when using Docker use host.docker.internal)
OLLAMA_BASE_URL=http://localhost:11434

# Optional Google/Gemini keys (not needed when using Ollama)
#GOOGLE_API_KEY=
#GEMINI_API_KEY=
